# DataGuard Fortress Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ── Service Configuration ─────────────────────────────────────────────────────
# Service name for internal identification
SERVICE_NAME=dataguard-fortress

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (NEVER enable in production!)
DEBUG=false

# ── API Configuration ───────────────────────────────────────────────────────
# External API URL (for self-reporting and health checks)
EXTERNAL_API_URL=https://api.dataguard-fortress.example.com

# ── Core Configuration ──────────────────────────────────────────────────────
# Encryption key file path (optional - will be generated if not specified)
ENCRYPTION_KEY_PATH=/var/lib/dataguard-fortress/encryption.key

# Audit log file path
AUDIT_LOG_FILE=/var/log/dataguard-fortress/audit.log

# ── Rate Limiting Configuration ───────────────────────────────────────────────
# Redis URL for distributed token bucket (optional - uses memory if not set)
REDIS_URL=redis://localhost:6379/0

# Default rate limit (requests per minute)
DEFAULT_RATE_LIMIT=60

# ── PII Detection Configuration ───────────────────────────────────────────────
# Minimum confidence threshold for PII detection (0.0 to 1.0)
PII_CONFIDENCE_THRESHOLD=0.85

# ── Security Configuration ────────────────────────────────────────────────────
# Secret key for session signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Logging Configuration ────────────────────────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ── Optional: API Keys for External Services ──────────────────────────────────
# OpenAI API key (if using OpenAI models)
# OPENAI_API_KEY=

# Anthropic API key (if using Claude models)
# ANTHROPIC_API_KEY=

# Google API key (if using Gemini models)
# GOOGLE_API_KEY=